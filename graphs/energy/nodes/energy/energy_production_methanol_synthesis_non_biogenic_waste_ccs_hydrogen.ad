# This node is defined for methanol synthesis from non biogenic waste, where
# co2_emissions_primary needs to be defined for to retrieve the primary emissions of the hydrogen input.
# CO2 emissions of the final demand of the output products of fractionation are queried
# with the co2_emissions_refinery_products group.

- groups = [co2_emissions_primary, sankey_conversion_group]
- use = undefined
