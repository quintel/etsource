# This node is used as a balancing node for excess refinery gas. It is mostly needed because some
# countries use a lot of refinery gas in CHPs, this flow isn't modelled explicitly. There are also
# some accounting type flows on the energy balance. For many countries, the supply is therefore
# higher than the demand for refinery gas in the industry sector. This is a dead end in the graph.

- use = energetic
- groups = []
- free_co2_factor = 0.0
