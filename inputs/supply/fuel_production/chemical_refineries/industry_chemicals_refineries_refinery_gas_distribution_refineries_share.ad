- query =
    UPDATE(
      EDGE(industry_final_demand_for_chemical_refinery_gas, industry_final_demand_for_chemical_refineries_refinery_gas),
      share,
      DIVIDE(USER_INPUT(), 100.0)
    )
- share_group = refinery_gas_demand_distribution
- priority = 0
- max_value = 100.0
- min_value = 0.0
- start_value_gql = present:V(EDGE(industry_final_demand_for_chemical_refinery_gas, industry_final_demand_for_chemical_refineries_refinery_gas), parent_share) * 100.0
- step_value = 0.1
- unit = %
- update_period = future
