- query =
    UPDATE(
      EDGE(industry_final_demand_for_chemical_refinery_gas, industry_final_demand_for_chemical_other_refinery_gas),
      share,
      DIVIDE(USER_INPUT(), 100)
    )
- share_group = chemical_refineries_refinery_gas_distribution
- priority = 0
- max_value = 100.0
- min_value = 0.0
- start_value_gql = present:PRODUCT(DIVIDE(V(industry_final_demand_for_chemical_other_refinery_gas,demand),V(industry_final_demand_for_chemical_refinery_gas, demand)), 100)
- step_value = 0.1
- unit = %
- update_period = future
- disabled_by_couplings = [external_model_industry, industry_chemical_refineries]
