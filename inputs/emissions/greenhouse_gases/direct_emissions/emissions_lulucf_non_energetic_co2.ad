# Sets LULUCF emissions and removals molecule nodes
# - If positive, lulucf_emissions_non_energetic_co2 is updated with the user value and
#   lulucf_removals_non_energetic_co2 is set to zero.
# - If negative, lulucf_emissions_non_energetic_co2 is set to zero and
#   lulucf_removals_non_energetic_co2 is updated with the (positive) user value
#
# Note: the asymmetric use of GREATER_OR_EQUAL in the query and GREATER in the start_value_gql is
# intentional. GREATER_OR_EQUAL ensures that if the user value is 0, LULUCF removals are not set to
# -0. GREATER is used in the start_value_gql to ensure when emissions are zero, the demand
# of the removals node is used.

- query =
    IF(
      GREATER_OR_EQUAL(USER_INPUT(), 0.0),
      -> {
        EACH(
          UPDATE(
            MV(lulucf_emissions_non_energetic_co2),
            preset_demand,
            PRODUCT(USER_INPUT(), THOUSANDS)
          ),
          UPDATE(
            MV(lulucf_removals_non_energetic_co2),
            preset_demand,
            0.0
          )
        )
      },
      -> {
        EACH(
          UPDATE(
            MV(lulucf_emissions_non_energetic_co2),
            preset_demand,
            0.0
          ),
          UPDATE(
            MV(lulucf_removals_non_energetic_co2),
            preset_demand,
            NEG(PRODUCT((USER_INPUT()), THOUSANDS))
          )
        )
      }
    )
- priority = 0
- max_value_gql = present:PRODUCT(Q(direct_emissions_static_emissions_max_value), 3.0)
- min_value_gql = present:NEG(PRODUCT(Q(direct_emissions_static_emissions_max_value), 3.0))
- start_value_gql =
    present:IF(
      GREATER(MV(lulucf_emissions_non_energetic_co2, demand), 0.0),
      -> { DIVIDE(MV(lulucf_emissions_non_energetic_co2, demand), THOUSANDS) },
      -> { DIVIDE(NEG(MV(lulucf_removals_non_energetic_co2, demand)), THOUSANDS) }
    )
- step_value = 0.1
- unit = T
- update_period = future
