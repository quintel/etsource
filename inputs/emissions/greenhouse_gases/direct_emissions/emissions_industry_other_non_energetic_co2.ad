- query =
    UPDATE(
      MV(industry_other_non_energetic_co2),
      preset_demand,
      PRODUCT(USER_INPUT(), THOUSANDS)
    )
- priority = 0
- max_value_gql = present:PRODUCT(Q(direct_emissions_static_emissions_max_value), 3.0)
- min_value = 0.0
- start_value_gql = present:DIVIDE(MV(industry_other_non_energetic_co2, demand), THOUSANDS)
- step_value = 0.1
- unit = T
- update_period = future
