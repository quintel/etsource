# This input lets you decide what part of the new buildings will be terraced houses.
# The total number of new buildings is set in total_number_of_residences_new.ad
# The start value is based on the share of terraced houses in the exisiting building stock.
# Priorities of related inputs are set as follows:
# - 4: shares of new buildings & shares of buildings demolished
# - 3: number of new buildings & number of buildings demolished
# - 2: setting weather curve
# - 1: insulation sliders
# - 0: behaviour slider & outdoor temperature

- query = UPDATE()
- share_group = households_new_residences
- priority = 4
- max_value = 100.0
- min_value = 0.0
- start_value_gql = present:Q(households_share_of_terraced)
- step_value = 0.1
- unit = %
- update_period = future
