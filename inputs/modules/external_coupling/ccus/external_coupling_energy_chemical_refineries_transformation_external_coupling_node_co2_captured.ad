- query =
    UPDATE(
      MEDGE(energy_chemical_refineries_transformation_external_coupling_node_captured_co2, energy_chemical_refineries_transformation_external_coupling_node_co2),
      share,
      DIVIDE(USER_INPUT(), 100.0)
    )
- priority = 0
- max_value = 100.0
- min_value = 0.0
- start_value = 0.0
- step_value = 1.0
- unit = %
- update_period = future
- coupling_groups = [external_model_industry, ccus]
