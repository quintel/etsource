# Share of the locally available refinery gas that is used in industry. The locally available
# refinery gas is the refinery gas output, topped up with crude oil when industry uses more than
# the refineries produce. Datasets without any refinery gas fall back to a share of 1.0.

- query =
    refinery_gas_output = DATASET_INPUT(input_industry_refinery_transformation_crude_oil_refinery_gas_demand);
    refinery_gas_demand =
      DATASET_INPUT(input_industry_chemical_other_refinery_gas_demand) +
      DATASET_INPUT(input_industry_chemical_refineries_refinery_gas_demand);
    locally_available = IF(refinery_gas_output > refinery_gas_demand, refinery_gas_output, refinery_gas_demand);

    IF(locally_available > 0.0, 1.0 * refinery_gas_demand / locally_available, 1.0)
