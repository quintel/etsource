# Share of the refinery gas in industry that goes to refineries.

- query =
    chemical_other_refinery_gas_demand = 1.0 * DATASET_INPUT(input_industry_chemical_other_refinery_gas_demand);
    chemical_refineries_refinery_gas_demand = 1.0 * DATASET_INPUT(input_industry_chemical_refineries_refinery_gas_demand);
    total_chemical_refinery_gas_demand = chemical_other_refinery_gas_demand + chemical_refineries_refinery_gas_demand;

    IF(total_chemical_refinery_gas_demand > 0.0, DIVIDE(chemical_refineries_refinery_gas_demand, total_chemical_refinery_gas_demand), 1.0)
