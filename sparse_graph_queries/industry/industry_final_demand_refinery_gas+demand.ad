# Refinery gas used in chemicals other and by the refineries themselves. Refinery gas used in
# other industry subsectors is not modelled explicitly; it stays part of their oil demand.
# This is only the case for the countries DE and SG

- query =
    DATASET_INPUT(input_industry_chemical_other_refinery_gas_demand) +
    DATASET_INPUT(input_industry_chemical_refineries_refinery_gas_demand)
