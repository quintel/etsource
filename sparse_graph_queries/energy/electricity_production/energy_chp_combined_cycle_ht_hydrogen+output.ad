# Assumed the same electricity and heat efficiency as network gas variant

- query =
    {
      steam_hot_water: DIVIDE(DATASET_INPUT(input_energy_chp_combined_cycle_network_gas_steam_hot_water_output_conversion), 100.0),
      electricity: DIVIDE(DATASET_INPUT(input_energy_chp_combined_cycle_network_gas_electricity_output_conversion), 100.0)
    }
